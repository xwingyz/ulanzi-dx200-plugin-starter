      "UUID": "com.ulanzi.ulanzistudio.mihome.studylight",
      "States": [
        {
          "Name": "Default",
          "Image": "assets/icons/actionStudylight.svg"
        }
      ],
      "Devices": [],
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false
    },
    {
      "Name": "Dining Spotlights",
      "Tooltip": "Toggle dining spotlights 1 and 2 together through Home Assistant.",
      "Icon": "assets/icons/actionDiningspotlights.svg",
      "PropertyInspectorPath": "property-inspector/diningspotlights.html",
      "UUID": "com.ulanzi.ulanzistudio.mihome.diningspotlights",
      "States": [
        {
          "Name": "Default",
          "Image": "assets/icons/actionDiningspotlights.svg"
        }
      ],
      "Devices": [],
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false
    }
  ],
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
